# App
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# MongoDB
MONGODB_URI=mongodb://localhost:27017/banking_system

# JWT (use a long random secret in production)
JWT_SECRET=replace-with-a-long-random-secret-min-64-chars
JWT_ACCESS_EXPIRATION_MS=600000
JWT_REFRESH_EXPIRATION_MS=604800000

# CORS (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Rate limit
RATE_LIMIT_LOGIN_MAX_REQUESTS=10
RATE_LIMIT_LOGIN_WINDOW_MS=60000
RATE_LIMIT_TRANSFER_MAX_REQUESTS=20
RATE_LIMIT_TRANSFER_WINDOW_MS=60000

# Admin bootstrap (disable in production)
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_FULL_NAME=Platform Admin
BOOTSTRAP_ADMIN_EMAIL=admin@banking.local
BOOTSTRAP_ADMIN_PASSWORD=Admin@12345
